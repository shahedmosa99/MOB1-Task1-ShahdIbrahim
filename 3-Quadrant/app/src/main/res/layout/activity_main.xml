<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Quadrant"
            android:background="@color/quadrant_1">

            <TextView
                style="@style/QuadrantTitle"
                android:text="@string/first_title" />

            <TextView
                style="@style/QuadrantBody"
                android:text="@string/first_description" />
        </LinearLayout>

        <LinearLayout
            style="@style/Quadrant"
            android:background="@color/quadrant_2">

            <TextView
                style="@style/QuadrantTitle"
                android:text="@string/second_title" />

            <TextView
                style="@style/QuadrantBody"
                android:text="@string/second_description" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Quadrant"
            android:background="@color/quadrant_3">

            <TextView
                style="@style/QuadrantTitle"
                android:text="@string/third_title" />

            <TextView
                style="@style/QuadrantBody"
                android:text="@string/third_description" />
        </LinearLayout>

        <LinearLayout
            style="@style/Quadrant"
            android:background="@color/quadrant_4">

            <TextView
                style="@style/QuadrantTitle"
                android:text="@string/fourth_title" />

            <TextView
                style="@style/QuadrantBody"
                android:text="@string/fourth_description" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
